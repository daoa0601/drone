# Loopback-only defaults. A bearer token is mandatory for non-loopback binds.
DRONE_HOST=127.0.0.1
DRONE_PORT=8090
DRONE_HOME=.drone
DRONE_BEARER_TOKEN=
DRONE_MAX_ACTIVE_JOBS=2
DRONE_MAX_JSON_BYTES=65536
DRONE_MAX_ARTIFACT_BYTES=268435456

# Native Apple backend is fail-closed until its runtime is provisioned and independently attested.
DRONE_APPLE_NATIVE_ENABLED=false
DRONE_APPLE_NATIVE_DRIVER=.drone/bin/drone-sandboxd
DRONE_APPLE_NATIVE_KERNEL=.drone/runtime/vmlinux-arm64
DRONE_APPLE_NATIVE_INITFS=.drone/runtime/vminit.ext4
DRONE_APPLE_NATIVE_STATE=.drone/runtime/state
DRONE_APPLE_NATIVE_ATTESTATION=.drone/runtime/apple-native-attestation.json
DRONE_APPLE_NATIVE_ATTESTATION_PUBLIC_KEY=.drone/runtime/apple-native-attestor.pub.pem
